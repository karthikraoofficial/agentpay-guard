# Where the consent screen calls the API. Inlined at build time (NEXT_PUBLIC_), so
# set it before `npm run build`. The API must list this app's origin as
# AGENTPAY_WEB_ORIGIN, or the browser refuses the calls (CORS).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Where the /demo page calls the Demo runner (ADR-0031): `uv run python -m demo_runner`
# locally, https://<AGENTPAY_API_HOST>/demo-runner on the hosted demo. Inlined at build
# time. The runner must list this app's origin as AGENTPAY_WEB_ORIGIN.
NEXT_PUBLIC_DEMO_RUNNER_URL=http://localhost:8100
