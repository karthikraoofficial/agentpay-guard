{
  "$defs": {
    "CurrencyBands": {
      "additionalProperties": false,
      "description": "Risk tier bands for one currency, in integer minor units. An amount below\n`medium_from` is low; from `step_up_threshold` up it is high and needs step_up.",
      "properties": {
        "medium_from": {
          "exclusiveMinimum": 0,
          "title": "Medium From",
          "type": "integer"
        },
        "step_up_threshold": {
          "exclusiveMinimum": 0,
          "title": "Step Up Threshold",
          "type": "integer"
        }
      },
      "required": [
        "medium_from",
        "step_up_threshold"
      ],
      "title": "CurrencyBands",
      "type": "object"
    },
    "DisputeReasonRules": {
      "additionalProperties": false,
      "description": "How one Dispute reason is filed and weighed. Evidence strength is weak if any\n`weak_when` fact holds, strong if every `strong_when` fact holds, and mixed otherwise.\n`strong_when` is also the evidence the reason needs: what is missing from it is shown.",
      "properties": {
        "network_codes": {
          "$ref": "#/$defs/NetworkCodes"
        },
        "strong_when": {
          "items": {
            "enum": [
              "decision_within_mandate",
              "payer_intent_confirmed",
              "intent_mismatch_approved",
              "mandate_revoked_before_capture",
              "mandate_active_at_decision",
              "mandate_revoked_before_decision",
              "amount_matches_decision",
              "amount_differs_from_decision",
              "within_quoted_total",
              "no_duplicate_payment",
              "duplicate_payment_found",
              "fulfilment_evidence"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Strong When",
          "type": "array"
        },
        "weak_when": {
          "default": [],
          "items": {
            "enum": [
              "decision_within_mandate",
              "payer_intent_confirmed",
              "intent_mismatch_approved",
              "mandate_revoked_before_capture",
              "mandate_active_at_decision",
              "mandate_revoked_before_decision",
              "amount_matches_decision",
              "amount_differs_from_decision",
              "within_quoted_total",
              "no_duplicate_payment",
              "duplicate_payment_found",
              "fulfilment_evidence"
            ],
            "type": "string"
          },
          "title": "Weak When",
          "type": "array"
        }
      },
      "required": [
        "network_codes",
        "strong_when"
      ],
      "title": "DisputeReasonRules",
      "type": "object"
    },
    "DisputeRules": {
      "additionalProperties": false,
      "description": "Network codes and Evidence strength for Disputes, one entry per Dispute reason.",
      "properties": {
        "duplicate_window_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duplicate Window Seconds",
          "type": "integer"
        },
        "reasons": {
          "additionalProperties": {
            "$ref": "#/$defs/DisputeReasonRules"
          },
          "propertyNames": {
            "enum": [
              "unauthorised",
              "not_as_described",
              "not_received",
              "duplicate",
              "amount_differs",
              "cancelled_recurring"
            ]
          },
          "title": "Reasons",
          "type": "object"
        }
      },
      "required": [
        "duplicate_window_seconds",
        "reasons"
      ],
      "title": "DisputeRules",
      "type": "object"
    },
    "IntentParams": {
      "additionalProperties": false,
      "description": "How long an Intent verdict can be cited after the check, and the lowest Risk tier\nthat needs a usable match.",
      "properties": {
        "verdict_ttl_seconds": {
          "exclusiveMinimum": 0,
          "title": "Verdict Ttl Seconds",
          "type": "integer"
        },
        "min_tier": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Min Tier",
          "type": "string"
        }
      },
      "required": [
        "verdict_ttl_seconds",
        "min_tier"
      ],
      "title": "IntentParams",
      "type": "object"
    },
    "MerchantNewParams": {
      "additionalProperties": false,
      "description": "The lowest Risk tier at which a first payment to a merchant needs approval.",
      "properties": {
        "min_tier": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Min Tier",
          "type": "string"
        }
      },
      "required": [
        "min_tier"
      ],
      "title": "MerchantNewParams",
      "type": "object"
    },
    "NetworkCodes": {
      "additionalProperties": false,
      "description": "The card network reason codes a Dispute reason is filed under.",
      "properties": {
        "visa": {
          "pattern": "^\\d{2}(\\.\\d+)+$",
          "title": "Visa",
          "type": "string"
        },
        "mastercard": {
          "pattern": "^\\d{4}$",
          "title": "Mastercard",
          "type": "string"
        }
      },
      "required": [
        "visa",
        "mastercard"
      ],
      "title": "NetworkCodes",
      "type": "object"
    },
    "PriceDriftParams": {
      "additionalProperties": false,
      "description": "Step up when the amount is more than `max_above_bps` above the Quoted total.",
      "properties": {
        "max_above_bps": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Max Above Bps",
          "type": "integer"
        }
      },
      "required": [
        "max_above_bps"
      ],
      "title": "PriceDriftParams",
      "type": "object"
    },
    "RuleSetting": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "enum": [
            "mandate_revoked",
            "mandate_validity",
            "agent_allowed",
            "agent_disabled",
            "currency_match",
            "mcc_high_risk",
            "mcc_allowed",
            "per_txn_cap",
            "monthly_cap",
            "step_up_threshold",
            "monthly_cap_near",
            "velocity",
            "merchant_new",
            "intent",
            "price_drift"
          ],
          "title": "Rule Id",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "rule_id",
        "enabled"
      ],
      "title": "RuleSetting",
      "type": "object"
    },
    "VelocityParams": {
      "additionalProperties": false,
      "description": "Step up once `max_decisions` earlier Decisions on the Mandate, of any Outcome,\nwere made less than `window_seconds` before the Decision time (or at it).",
      "properties": {
        "max_decisions": {
          "exclusiveMinimum": 0,
          "title": "Max Decisions",
          "type": "integer"
        },
        "window_seconds": {
          "exclusiveMinimum": 0,
          "title": "Window Seconds",
          "type": "integer"
        }
      },
      "required": [
        "max_decisions",
        "window_seconds"
      ],
      "title": "VelocityParams",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    },
    "currencies": {
      "minProperties": 1,
      "patternProperties": {
        "^[A-Z]{3}$": {
          "$ref": "#/$defs/CurrencyBands"
        }
      },
      "title": "Currencies",
      "type": "object"
    },
    "high_risk_mccs": {
      "items": {
        "pattern": "^\\d{4}$",
        "type": "string"
      },
      "title": "High Risk Mccs",
      "type": "array"
    },
    "monthly_cap_near_ratio_bps": {
      "exclusiveMinimum": 0,
      "maximum": 10000,
      "title": "Monthly Cap Near Ratio Bps",
      "type": "integer"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/RuleSetting"
      },
      "minItems": 1,
      "title": "Rules",
      "type": "array"
    },
    "velocity": {
      "anyOf": [
        {
          "$ref": "#/$defs/VelocityParams"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "merchant_new": {
      "anyOf": [
        {
          "$ref": "#/$defs/MerchantNewParams"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "intent": {
      "anyOf": [
        {
          "$ref": "#/$defs/IntentParams"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "price_drift": {
      "anyOf": [
        {
          "$ref": "#/$defs/PriceDriftParams"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "consent_ttl_seconds": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Consent Ttl Seconds"
    },
    "payment_window_seconds": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Payment Window Seconds"
    },
    "disputes": {
      "anyOf": [
        {
          "$ref": "#/$defs/DisputeRules"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "version",
    "currencies",
    "high_risk_mccs",
    "monthly_cap_near_ratio_bps",
    "rules"
  ],
  "title": "PolicyPack",
  "type": "object"
}
