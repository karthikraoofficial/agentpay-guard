{
  "$defs": {
    "CurrencyBands": {
      "additionalProperties": false,
      "description": "Risk tier bands for one currency, in integer minor units. An amount below\n`medium_from` is low; from `step_up_threshold` up it is high and needs step_up.",
      "properties": {
        "medium_from": {
          "exclusiveMinimum": 0,
          "title": "Medium From",
          "type": "integer"
        },
        "step_up_threshold": {
          "exclusiveMinimum": 0,
          "title": "Step Up Threshold",
          "type": "integer"
        }
      },
      "required": [
        "medium_from",
        "step_up_threshold"
      ],
      "title": "CurrencyBands",
      "type": "object"
    },
    "IntentParams": {
      "additionalProperties": false,
      "description": "How long an Intent verdict can be cited after the check, and the lowest Risk tier\nthat needs a usable match.",
      "properties": {
        "verdict_ttl_seconds": {
          "exclusiveMinimum": 0,
          "title": "Verdict Ttl Seconds",
          "type": "integer"
        },
        "min_tier": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Min Tier",
          "type": "string"
        }
      },
      "required": [
        "verdict_ttl_seconds",
        "min_tier"
      ],
      "title": "IntentParams",
      "type": "object"
    },
    "PriceDriftParams": {
      "additionalProperties": false,
      "description": "Step up when the amount is more than `max_above_bps` above the Quoted total.",
      "properties": {
        "max_above_bps": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Max Above Bps",
          "type": "integer"
        }
      },
      "required": [
        "max_above_bps"
      ],
      "title": "PriceDriftParams",
      "type": "object"
    },
    "RuleSetting": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "enum": [
            "mandate_revoked",
            "mandate_validity",
            "agent_allowed",
            "agent_disabled",
            "currency_match",
            "mcc_high_risk",
            "mcc_allowed",
            "per_txn_cap",
            "monthly_cap",
            "step_up_threshold",
            "monthly_cap_near",
            "velocity",
            "intent",
            "price_drift"
          ],
          "title": "Rule Id",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "rule_id",
        "enabled"
      ],
      "title": "RuleSetting",
      "type": "object"
    },
    "VelocityParams": {
      "additionalProperties": false,
      "description": "Step up once `max_decisions` earlier Decisions on the Mandate, of any Outcome,\nwere made less than `window_seconds` before the Decision time (or at it).",
      "properties": {
        "max_decisions": {
          "exclusiveMinimum": 0,
          "title": "Max Decisions",
          "type": "integer"
        },
        "window_seconds": {
          "exclusiveMinimum": 0,
          "title": "Window Seconds",
          "type": "integer"
        }
      },
      "required": [
        "max_decisions",
        "window_seconds"
      ],
      "title": "VelocityParams",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    },
    "currencies": {
      "minProperties": 1,
      "patternProperties": {
        "^[A-Z]{3}$": {
          "$ref": "#/$defs/CurrencyBands"
        }
      },
      "title": "Currencies",
      "type": "object"
    },
    "high_risk_mccs": {
      "items": {
        "pattern": "^\\d{4}$",
        "type": "string"
      },
      "title": "High Risk Mccs",
      "type": "array"
    },
    "monthly_cap_near_ratio_bps": {
      "exclusiveMinimum": 0,
      "maximum": 10000,
      "title": "Monthly Cap Near Ratio Bps",
      "type": "integer"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/RuleSetting"
      },
      "minItems": 1,
      "title": "Rules",
      "type": "array"
    },
    "velocity": {
      "anyOf": [
        {
          "$ref": "#/$defs/VelocityParams"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "intent": {
      "anyOf": [
        {
          "$ref": "#/$defs/IntentParams"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "price_drift": {
      "anyOf": [
        {
          "$ref": "#/$defs/PriceDriftParams"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "version",
    "currencies",
    "high_risk_mccs",
    "monthly_cap_near_ratio_bps",
    "rules"
  ],
  "title": "PolicyPack",
  "type": "object"
}
