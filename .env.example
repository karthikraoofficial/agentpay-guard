# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Required: the app refuses to start without these.
AGENTPAY_ENV=local
AGENTPAY_DATABASE_URL=postgresql+psycopg://agentpay:agentpay@localhost:5432/agentpay
AGENTPAY_TEMPORAL_ADDRESS=localhost:7233
AGENTPAY_TEMPORAL_NAMESPACE=default
AGENTPAY_TEMPORAL_TASK_QUEUE=agentpay-consent
AGENTPAY_OTEL_EXPORTER_ENDPOINT=http://localhost:4318

# Optional, with defaults
AGENTPAY_APP_NAME=agentpay-guard
AGENTPAY_APP_VERSION=0.1.0
AGENTPAY_POLICY_PACKS_DIR=policy_packs
# otlp sends traces and metrics to AGENTPAY_OTEL_EXPORTER_ENDPOINT; none exports nothing
AGENTPAY_TELEMETRY_EXPORTER=otlp

# Required while the Intent check is enabled (any env except test): the app refuses to
# start without it. Set AGENTPAY_INTENT_CHECK_ENABLED=false to run without a key; every
# Intent check is then "unknown" and Decisions that need one step up.
# AGENTPAY_ANTHROPIC_API_KEY=
AGENTPAY_INTENT_CHECK_ENABLED=true
AGENTPAY_INTENT_CHECK_MODEL=claude-haiku-5-5
AGENTPAY_INTENT_CHECK_TIMEOUT_MS=2500

# How often the outbox relay looks for undelivered events, such as a step_up's
# consent workflow start (ADR-0009).
AGENTPAY_OUTBOX_POLL_INTERVAL_MS=1000
