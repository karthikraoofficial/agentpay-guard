# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Required: the app refuses to start without these.
AGENTPAY_ENV=local
AGENTPAY_DATABASE_URL=postgresql+psycopg://agentpay:agentpay@localhost:5432/agentpay
AGENTPAY_TEMPORAL_ADDRESS=localhost:7233
AGENTPAY_TEMPORAL_NAMESPACE=default
AGENTPAY_TEMPORAL_TASK_QUEUE=agentpay-consent
AGENTPAY_OTEL_EXPORTER_ENDPOINT=http://localhost:4318

# Optional, with defaults
AGENTPAY_APP_NAME=agentpay-guard
AGENTPAY_APP_VERSION=0.2.0
AGENTPAY_POLICY_PACKS_DIR=policy_packs
# otlp sends traces and metrics to AGENTPAY_OTEL_EXPORTER_ENDPOINT; none exports nothing
AGENTPAY_TELEMETRY_EXPORTER=otlp

# Optional: the OTel collector also sends traces to Langfuse when both keys are set.
# Read by `docker compose --env-file .env` for the collector only, never by the app.
# AGENTPAY_LANGFUSE_PUBLIC_KEY=pk-lf-...
# AGENTPAY_LANGFUSE_SECRET_KEY=sk-lf-...
# AGENTPAY_LANGFUSE_HOST=https://cloud.langfuse.com

# Required while the Intent check is enabled (any env except test): the app refuses to
# start without it. Set AGENTPAY_INTENT_CHECK_ENABLED=false to run without a key; every
# Intent check is then "unknown" and Decisions that need one step up.
# AGENTPAY_ANTHROPIC_API_KEY=
AGENTPAY_INTENT_CHECK_ENABLED=true
AGENTPAY_INTENT_CHECK_MODEL=claude-haiku-5-5
AGENTPAY_INTENT_CHECK_TIMEOUT_MS=2500

# The dispute evidence agent writes each Evidence pack's narrative (worker only, off
# every request path). Without a key, when off, or on any failure, the narrative is
# written by code instead.
AGENTPAY_DISPUTE_NARRATIVE_ENABLED=true
AGENTPAY_DISPUTE_NARRATIVE_MODEL=claude-sonnet-5-5
AGENTPAY_DISPUTE_NARRATIVE_TIMEOUT_MS=45000

# The Model spend cap (ADR-0020): model calls each Tenant may make per UTC day. Past it
# the model isn't called: the Intent check is unknown (cause "capped") and the narrative
# is written by code. 0 stops that purpose's calls.
AGENTPAY_INTENT_CHECK_DAILY_CAP=200
AGENTPAY_DISPUTE_NARRATIVE_DAILY_CAP=20

# The consent screen's origin: Consent links point here, and only it gets CORS on the
# Consent link endpoints.
AGENTPAY_WEB_ORIGIN=http://localhost:3000

# How often the outbox relay looks for undelivered events, such as a step_up's
# consent workflow start (ADR-0009).
AGENTPAY_OUTBOX_POLL_INTERVAL_MS=1000

# The most Evidence pack versions one Dispute may have (each Regenerate is one).
AGENTPAY_DISPUTE_PACK_VERSIONS_MAX=3

# How long a Review link to the dispute viewer works, at most (never past respond_by).
AGENTPAY_REVIEW_LINK_TTL_SECONDS=259200

# The rail Payments go through. mock settles in-process and needs no account; razorpay
# needs the key id, key secret and webhook secret below (ADR-0012, ADR-0013).
AGENTPAY_RAIL=mock

# The reconciliation sweep in the worker: every interval, ask the rail about Payments
# still scheduled this many seconds after they were made (#82). Off on the mock rail
# unless mock settle is on.
AGENTPAY_RECONCILE_INTERVAL_SECONDS=300
AGENTPAY_RECONCILE_AFTER_SECONDS=600

# Mock settle, for the hosted demo only (ADR-0019): with the mock rail, the worker's
# sweep captures every debited mock Payment older than this many seconds, so demo
# journey 3 can dispute it. Leave unset elsewhere; refused with AGENTPAY_RAIL=razorpay.
# AGENTPAY_MOCK_SETTLE_AFTER_SECONDS=60

# The Razorpay test-mode account (Dashboard > Account & Settings > API Keys, in Test
# Mode). Only a test key (rzp_test_...) is accepted, on any rail.
# AGENTPAY_RAZORPAY_KEY_ID=rzp_test_...
# AGENTPAY_RAZORPAY_KEY_SECRET=

# The secret Razorpay signs its webhooks with (Dashboard > Webhooks). Unset, every
# inbound rail webhook to /v1/rail/razorpay/webhooks is refused.
# AGENTPAY_RAZORPAY_WEBHOOK_SECRET=

# Encrypts Tenant webhook signing secrets at rest (ADR-0015). Unset, no webhook endpoint
# can be registered. Make one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AGENTPAY_WEBHOOK_ENCRYPTION_KEY=

# A registered test card for the Razorpay contract tests only. Printed by
# `uv run python -m adapters.razorpay.wizard`; it expires within about a day.
# AGENTPAY_RAZORPAY_TEST_CUSTOMER_REF=
# AGENTPAY_RAZORPAY_TEST_TOKEN_REF=

# The Demo Tenant's keys, for `uv run python -m demo` only: the agent key and tenant key
# `python -m api.admin create-tenant` printed. The API never reads them.
# AGENTPAY_DEMO_AGENT_KEY=
# AGENTPAY_DEMO_TENANT_KEY=
