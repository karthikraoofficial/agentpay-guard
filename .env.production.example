# The hosted demo (ADR-0021). Copy to .env on the VM and replace every placeholder; never
# commit the real file. Used by `docker compose --env-file .env -f infra/docker-compose.yml
# -f infra/docker-compose.prod.yml up -d --build`. The compose file sets the database URL,
# Temporal address and collector endpoint itself, so they are not listed here.

# The stack
AGENTPAY_ENV=production
# The API's public hostname. Caddy gets its HTTPS certificate for it. A free one with no
# account: api.<the VM's public IP, dashes for dots>.sslip.io
AGENTPAY_API_HOST=api.203-0-113-10.sslip.io
# Postgres's password, read when its volume is first created.
AGENTPAY_POSTGRES_PASSWORD=replace-with-a-long-random-password

# The web app on Vercel: Consent links and Review links point here, and only it may call
# them from a browser. Vercel's NEXT_PUBLIC_API_URL is https://<AGENTPAY_API_HOST>.
AGENTPAY_WEB_ORIGIN=https://agentpay-guard.vercel.app

# Model calls: the only cost of the hosted demo.
AGENTPAY_ANTHROPIC_API_KEY=sk-ant-replace-me
AGENTPAY_INTENT_CHECK_ENABLED=true
AGENTPAY_INTENT_CHECK_MODEL=claude-haiku-5-5
AGENTPAY_DISPUTE_NARRATIVE_ENABLED=true
AGENTPAY_DISPUTE_NARRATIVE_MODEL=claude-sonnet-5-5
# The Model spend cap (ADR-0020): calls each Tenant may make per UTC day.
AGENTPAY_INTENT_CHECK_DAILY_CAP=200
AGENTPAY_DISPUTE_NARRATIVE_DAILY_CAP=20

# The mock rail, with mock settle so a demo Payment reaches captured and can be disputed
# (ADR-0019). Never set with a real rail.
AGENTPAY_RAIL=mock
AGENTPAY_MOCK_SETTLE_AFTER_SECONDS=60
AGENTPAY_RECONCILE_INTERVAL_SECONDS=30

# Encrypts Tenant webhook signing secrets: a Fernet key, made with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENTPAY_WEBHOOK_ENCRYPTION_KEY=replace-with-a-fernet-key

# Telemetry: the app sends to the collector, which sends traces to Langfuse.
AGENTPAY_TELEMETRY_EXPORTER=otlp
AGENTPAY_LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
AGENTPAY_LANGFUSE_SECRET_KEY=sk-lf-replace-me
AGENTPAY_LANGFUSE_HOST=https://cloud.langfuse.com
