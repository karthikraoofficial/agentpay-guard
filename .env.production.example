# The hosted demo (ADR-0021). Copy to .env on the VM and replace every placeholder; never
# commit the real file. Used by `docker compose --env-file .env -f infra/docker-compose.yml
# -f infra/docker-compose.prod.yml up -d --build`. The compose file sets the database URL,
# Temporal address and collector endpoint itself, so they are not listed here.

# The stack
AGENTPAY_ENV=production
# The API's public hostname. Caddy gets its HTTPS certificate for it. A free one with no
# account: api.<the VM's public IP, dashes for dots>.sslip.io
AGENTPAY_API_HOST=api.203-0-113-10.sslip.io
# Postgres's password, read when its volume is first created.
AGENTPAY_POSTGRES_PASSWORD=replace-with-a-long-random-password

# The web app on Vercel: Consent links and Review links point here, and only it may call
# them from a browser. Vercel's NEXT_PUBLIC_API_URL is https://<AGENTPAY_API_HOST>.
AGENTPAY_WEB_ORIGIN=https://agentpay-guard.vercel.app

# Model calls: the only cost of the hosted demo.
AGENTPAY_ANTHROPIC_API_KEY=sk-ant-replace-me
AGENTPAY_INTENT_CHECK_ENABLED=true
AGENTPAY_INTENT_CHECK_MODEL=claude-haiku-5-5
AGENTPAY_DISPUTE_NARRATIVE_ENABLED=true
AGENTPAY_DISPUTE_NARRATIVE_MODEL=claude-haiku-5-5
# The Model spend cap (ADR-0020): calls each Tenant may make per UTC day.
AGENTPAY_INTENT_CHECK_DAILY_CAP=200
AGENTPAY_DISPUTE_NARRATIVE_DAILY_CAP=20

# The mock rail, with mock settle so a demo Payment reaches captured and can be disputed
# (ADR-0019). Never set with a real rail.
AGENTPAY_RAIL=mock
AGENTPAY_MOCK_SETTLE_AFTER_SECONDS=60
AGENTPAY_RECONCILE_INTERVAL_SECONDS=30
# The mock rail's Pre-debit notice period, so a demo debit behaves like a card debit (#280).
AGENTPAY_MOCK_NOTICE_SECONDS=60
# The Demo Tenant's id, so Demo controls can end its timers early (ADR-0032). The provision
# wizard's Demo Tenant stage writes it. Unset, the fast-forward journeys can't play.
# AGENTPAY_DEMO_CONTROLS_TENANT_ID=

# Encrypts Tenant webhook signing secrets: a Fernet key, made with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENTPAY_WEBHOOK_ENCRYPTION_KEY=replace-with-a-fernet-key

# Telemetry: the app sends to the collector, which sends traces to Langfuse.
AGENTPAY_TELEMETRY_EXPORTER=otlp
AGENTPAY_LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
AGENTPAY_LANGFUSE_SECRET_KEY=sk-lf-replace-me
AGENTPAY_LANGFUSE_HOST=https://cloud.langfuse.com
# Metrics to Grafana Cloud (#228, ADR-0026), where the alert rules in infra/grafana/ read
# them. Collector only, never the app. The provision wizard's metric alerts stage fills
# both: the stack's OTLP gateway, and base64 of "<instance id>:<token>" (a secret). Left
# empty, metrics stay on the collector's console.
AGENTPAY_GRAFANA_OTLP_ENDPOINT=
AGENTPAY_GRAFANA_OTLP_AUTH=

# Nightly backups (#200, ADR-0023), read by infra/pg-backup.sh, never by the app. The
# provision wizard's backups stage fills both: a write-only Object Storage upload link (a
# secret) and the date it expires. Left empty, dumps stay on the VM only.
AGENTPAY_BACKUP_PAR_URL=
AGENTPAY_BACKUP_PAR_EXPIRES=

# Backup heartbeats (#227, ADR-0026), read by infra/pg-backup.sh, never by the app: the
# ping URLs of two Healthchecks.io checks (secrets), pinged after each nightly dump and each
# weekly restore check, and at their /fail when one fails. A missed or failed run emails.
# The provision wizard's alerts stage fills both. Left empty, nothing is pinged.
AGENTPAY_BACKUP_HEARTBEAT_URL=
AGENTPAY_RESTORE_CHECK_HEARTBEAT_URL=

# The Demo runner (#273, ADR-0031), at https://<AGENTPAY_API_HOST>/demo-runner/: it holds
# the Demo Tenant's two keys (test keys only) and plays Scenarios for the web app's /demo
# page. The provision wizard's Demo Tenant stage writes both keys here; until then the
# runner restarts without serving. Vercel's NEXT_PUBLIC_DEMO_RUNNER_URL is
# https://<AGENTPAY_API_HOST>/demo-runner.
# AGENTPAY_DEMO_AGENT_KEY=
# AGENTPAY_DEMO_TENANT_KEY=
# Rate limits: runs one client IP may start a minute, and runs in progress at once.
AGENTPAY_DEMO_RUNNER_RUNS_PER_IP_PER_MINUTE=5
AGENTPAY_DEMO_RUNNER_RUNS_IN_PROGRESS_MAX=20
# The Demo Tenant's Tenant webhooks go to https://<AGENTPAY_API_HOST>/demo-runner/webhooks,
# and the runner checks each signature with this secret (#286, Scenario H8). The Demo
# Tenant stage registers that endpoint and writes the secret here. Empty: H8 is off.
AGENTPAY_DEMO_RUNNER_WEBHOOK_SECRET=
