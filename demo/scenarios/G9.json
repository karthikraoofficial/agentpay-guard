{
  "id": "G9",
  "title": "The reviewer asks for a rewrite",
  "group": "G",
  "playlists": [
    "disputes"
  ],
  "story": "The reviewer finds the Evidence pack's summary unclear and presses Regenerate. The Guard builds version 2. Signing off version 1 is now refused, because a Sign-off always applies to one exact version, the latest. The reviewer signs off version 2.",
  "setup": {
    "mandate": {
      "per_txn_cap": {
        "minor": 1000000,
        "currency": "INR"
      },
      "monthly_cap": {
        "minor": 5000000,
        "currency": "INR"
      },
      "allowed_mccs": [
        "5411",
        "5812"
      ]
    },
    "merchant": {
      "id": "m_freshmart",
      "name": "FreshMart",
      "mcc": "5411"
    },
    "card": "token_mock_captures"
  },
  "steps": [
    {
      "actor": "agent",
      "tool": "request_decision",
      "amount": {
        "minor": 125000,
        "currency": "INR"
      },
      "chat": [
        {
          "speaker": "asha",
          "text": "Reorder my usual milk and bread, please."
        },
        {
          "speaker": "shopbot",
          "text": "Your usual basket at FreshMart comes to INR 1,250. Checking with AgentPay Guard before I pay."
        }
      ]
    },
    {
      "actor": "agent",
      "tool": "create_payment",
      "chat": [
        {
          "speaker": "shopbot",
          "text": "Allowed. Paying FreshMart now."
        }
      ]
    },
    {
      "actor": "agent",
      "tool": "get_payment",
      "until_status": [
        "captured",
        "failed"
      ],
      "chat": [
        {
          "speaker": "shopbot",
          "text": "The payment is scheduled. I'll let you know once the money is taken."
        }
      ]
    },
    {
      "actor": "tenant",
      "route": "POST /v1/disputes",
      "body": {
        "payment_id": "{payment_id}",
        "reason": "unauthorised"
      },
      "respond_in_days": 10,
      "chat": [
        {
          "speaker": "asha",
          "text": "I don't remember agreeing to this FreshMart charge. I've told my bank I never authorised it."
        }
      ]
    },
    {
      "actor": "tenant",
      "route": "GET /v1/disputes/{dispute_id}",
      "until_status": [
        "in_review"
      ]
    },
    {
      "actor": "reviewer",
      "action": "regenerate"
    },
    {
      "actor": "tenant",
      "route": "GET /v1/disputes/{dispute_id}",
      "until_status": [
        "in_review"
      ]
    },
    {
      "actor": "tenant",
      "route": "POST /v1/disputes/{dispute_id}/sign-off",
      "body": {
        "pack_version": 1,
        "reviewer": {
          "id": "demo-reviewer",
          "name": "Demo reviewer"
        }
      },
      "expect_refusal": "PACK_VERSION_NOT_CURRENT"
    },
    {
      "actor": "reviewer",
      "action": "sign_off"
    }
  ],
  "expected": {
    "outcome": "allow",
    "payment_status": "captured",
    "dispute_status": "ready",
    "refusal_code": "PACK_VERSION_NOT_CURRENT"
  },
  "what_to_notice": "Version 1 can't be signed once version 2 exists: PACK_VERSION_NOT_CURRENT. The Sign-off names version 2 and records its hash, so it is always clear which words were approved. Regenerating has a limit, so a pack can't be rewritten forever."
}
