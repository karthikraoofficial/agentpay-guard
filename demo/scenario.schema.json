{
  "$defs": {
    "AgentStep": {
      "additionalProperties": false,
      "description": "ShopBot calls a guard_mcp tool. The run fills in what it already knows (Mandate,\nAgent, merchant, the last Decision or Payment, the step's idempotency key).\n\n`route` instead of `tool` has ShopBot call an HTTP route with its decide key, for\njourneys that show a call no tool makes, e.g. trying to approve its own step_up.",
      "properties": {
        "actor": {
          "const": "agent",
          "title": "Actor",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "as_agent": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Agent"
        },
        "chat": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ChatLine"
          },
          "title": "Chat",
          "type": "array"
        },
        "expect_outcome": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "step_up",
                "block"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expect Outcome"
        },
        "expect_refusal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expect Refusal"
        },
        "instruction": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instruction"
        },
        "item": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item"
        },
        "route": {
          "anyOf": [
            {
              "pattern": "^(GET|POST) /v1/\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        },
        "sends": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Sends",
          "type": "integer"
        },
        "tool": {
          "anyOf": [
            {
              "enum": [
                "request_decision",
                "check_intent",
                "get_decision",
                "get_consent_request",
                "create_payment",
                "get_payment"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        },
        "until_status": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Until Status"
        }
      },
      "required": [
        "actor"
      ],
      "title": "AgentStep",
      "type": "object"
    },
    "ChatLine": {
      "additionalProperties": false,
      "properties": {
        "speaker": {
          "enum": [
            "asha",
            "shopbot",
            "dealhunter"
          ],
          "title": "Speaker",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "speaker",
        "text"
      ],
      "title": "ChatLine",
      "type": "object"
    },
    "Expected": {
      "additionalProperties": false,
      "description": "What the run must end with; CI checks each field that is set.",
      "properties": {
        "chain_clean": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chain Clean"
        },
        "consent_status": {
          "anyOf": [
            {
              "enum": [
                "pending",
                "approved",
                "declined",
                "expired",
                "blocked"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consent Status"
        },
        "dispute_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dispute Status"
        },
        "evidence_strength": {
          "anyOf": [
            {
              "enum": [
                "strong",
                "mixed",
                "weak"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Strength"
        },
        "mastercard_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mastercard Code"
        },
        "missing_evidence": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Evidence"
        },
        "narrative_source": {
          "anyOf": [
            {
              "enum": [
                "model",
                "template"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Narrative Source"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "step_up",
                "block"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "pack_clean": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pack Clean"
        },
        "payment_failure_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payment Failure Code"
        },
        "payment_status": {
          "anyOf": [
            {
              "enum": [
                "scheduled",
                "captured",
                "failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payment Status"
        },
        "reason_codes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Codes"
        },
        "refund_status": {
          "anyOf": [
            {
              "enum": [
                "pending",
                "processed",
                "failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refund Status"
        },
        "refusal_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refusal Code"
        },
        "replay_status": {
          "anyOf": [
            {
              "enum": [
                "identical",
                "different"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replay Status"
        },
        "visa_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visa Code"
        }
      },
      "title": "Expected",
      "type": "object"
    },
    "HumanStep": {
      "additionalProperties": false,
      "description": "A person acts: Asha on her Consent link, or the reviewer on a Review link.\n\nThe run mints the link. When a visitor plays Asha, the step waits until she has\nanswered on the consent screen; in CI the engine answers for her, sending each of\n`taps` with one idempotency key, as a double tap on a slow connection would.",
      "properties": {
        "action": {
          "enum": [
            "approve",
            "decline",
            "ignore",
            "sign_off",
            "regenerate"
          ],
          "title": "Action",
          "type": "string"
        },
        "actor": {
          "enum": [
            "payer",
            "reviewer"
          ],
          "title": "Actor",
          "type": "string"
        },
        "chat": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ChatLine"
          },
          "title": "Chat",
          "type": "array"
        },
        "taps": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Taps",
          "type": "integer"
        }
      },
      "required": [
        "actor",
        "action"
      ],
      "title": "HumanStep",
      "type": "object"
    },
    "MandateTerms": {
      "additionalProperties": false,
      "description": "What Asha grants ShopBot. Each run grants its own Payer, Agent and Mandate.",
      "properties": {
        "allowed_mccs": {
          "items": {
            "pattern": "^[0-9]{4}$",
            "type": "string"
          },
          "title": "Allowed Mccs",
          "type": "array"
        },
        "expired_days_ago": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expired Days Ago"
        },
        "monthly_cap": {
          "$ref": "#/$defs/Money"
        },
        "per_txn_cap": {
          "$ref": "#/$defs/Money"
        },
        "starts_in_days": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Starts In Days"
        },
        "valid_for_days": {
          "default": 30,
          "maximum": 365,
          "minimum": 1,
          "title": "Valid For Days",
          "type": "integer"
        }
      },
      "required": [
        "per_txn_cap",
        "monthly_cap",
        "allowed_mccs"
      ],
      "title": "MandateTerms",
      "type": "object"
    },
    "Merchant": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "mcc": {
          "pattern": "^\\d{4}$",
          "title": "Mcc",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "mcc"
      ],
      "title": "Merchant",
      "type": "object"
    },
    "ModelReply": {
      "additionalProperties": false,
      "description": "A scripted model reply CI plays through the fake model gateway, so CI makes no paid\ncall. The live demo compares the live verdict with it.\n\nAn Intent check's reply is `{\"verdict\": \"match\" | \"mismatch\" | \"unknown\"}`: the one\nword the model answers (core/signals/intent_check.py).",
      "properties": {
        "job": {
          "enum": [
            "intent_check",
            "dispute_narrative"
          ],
          "title": "Job",
          "type": "string"
        },
        "reply": {
          "additionalProperties": true,
          "title": "Reply",
          "type": "object"
        }
      },
      "required": [
        "job",
        "reply"
      ],
      "title": "ModelReply",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "description": "An amount in minor units (paise, cents). Floats are rejected, not rounded.",
      "properties": {
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "minor": {
          "description": "Amount in minor units, e.g. 12_500 = INR 125.00",
          "minimum": 0,
          "title": "Minor",
          "type": "integer"
        }
      },
      "required": [
        "minor",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "PriorPayment": {
      "additionalProperties": false,
      "description": "History built before the steps, e.g. for Spent this month: ShopBot asks for this\namount, is allowed, and pays. The setup doesn't wait for the Payment to be captured,\nsince an allow counts in Spent this month from the moment it is made (B2).",
      "properties": {
        "amount": {
          "$ref": "#/$defs/Money"
        },
        "merchant": {
          "anyOf": [
            {
              "$ref": "#/$defs/Merchant"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "amount"
      ],
      "title": "PriorPayment",
      "type": "object"
    },
    "Setup": {
      "additionalProperties": false,
      "properties": {
        "card": {
          "default": "token_mock_captures",
          "enum": [
            "token_mock_captures",
            "token_mock_fails",
            "token_mock_refused",
            "token_mock_times_out",
            "token_mock_notice_fails"
          ],
          "title": "Card",
          "type": "string"
        },
        "history": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PriorPayment"
          },
          "title": "History",
          "type": "array"
        },
        "mandate": {
          "$ref": "#/$defs/MandateTerms"
        },
        "merchant": {
          "$ref": "#/$defs/Merchant"
        }
      },
      "required": [
        "mandate",
        "merchant"
      ],
      "title": "Setup",
      "type": "object"
    },
    "TenantStep": {
      "additionalProperties": false,
      "description": "The wallet app calls an HTTP route with the tenant key, e.g.\n`POST /v1/mandates/{mandate_id}/revoke`.\n\nA body value that is exactly `{name}` is filled from the run as in a route, e.g.\n`{\"payment_id\": \"{payment_id}\"}` to open a Dispute on the run's Payment.",
      "properties": {
        "actor": {
          "const": "tenant",
          "title": "Actor",
          "type": "string"
        },
        "body": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "chat": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ChatLine"
          },
          "title": "Chat",
          "type": "array"
        },
        "expect_refusal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expect Refusal"
        },
        "respond_in_days": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Respond In Days"
        },
        "route": {
          "pattern": "^(GET|POST) /v1/\\S+$",
          "title": "Route",
          "type": "string"
        },
        "until_status": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Until Status"
        }
      },
      "required": [
        "actor",
        "route"
      ],
      "title": "TenantStep",
      "type": "object"
    },
    "VisitorStep": {
      "additionalProperties": false,
      "description": "The visitor presses a Demo control: a fast-forward ends a timer now, a switch forces\na failure (ADR-0032). On the demo page the run waits for the press; the CLI and CI\npress it at once.",
      "properties": {
        "actor": {
          "const": "visitor",
          "title": "Actor",
          "type": "string"
        },
        "chat": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ChatLine"
          },
          "title": "Chat",
          "type": "array"
        },
        "control": {
          "enum": [
            "expire_consent",
            "expire_payment_window",
            "expire_notice",
            "expire_dispute",
            "expire_refund_window",
            "ai_off",
            "rail_declining",
            "lose_payment",
            "rail_down",
            "tamper_copy"
          ],
          "title": "Control",
          "type": "string"
        },
        "label": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "actor",
        "control",
        "label"
      ],
      "title": "VisitorStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "demo_controls": {
      "default": [],
      "items": {
        "enum": [
          "expire_consent",
          "expire_payment_window",
          "expire_intent",
          "expire_notice",
          "expire_dispute",
          "expire_refund_window",
          "expire_mandate",
          "settle_now",
          "ai_off",
          "rail_declining",
          "lose_payment",
          "tamper_copy",
          "rail_down"
        ],
        "type": "string"
      },
      "title": "Demo Controls",
      "type": "array"
    },
    "expected": {
      "$ref": "#/$defs/Expected"
    },
    "group": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H"
      ],
      "title": "Group",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-H][0-9]{1,2}$",
      "title": "Id",
      "type": "string"
    },
    "model_replies": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ModelReply"
      },
      "title": "Model Replies",
      "type": "array"
    },
    "playlists": {
      "default": [],
      "items": {
        "enum": [
          "pitch",
          "payments-pm",
          "risk-compliance",
          "engineering",
          "disputes"
        ],
        "type": "string"
      },
      "title": "Playlists",
      "type": "array"
    },
    "setup": {
      "$ref": "#/$defs/Setup"
    },
    "steps": {
      "items": {
        "discriminator": {
          "mapping": {
            "agent": "#/$defs/AgentStep",
            "payer": "#/$defs/HumanStep",
            "reviewer": "#/$defs/HumanStep",
            "tenant": "#/$defs/TenantStep",
            "visitor": "#/$defs/VisitorStep"
          },
          "propertyName": "actor"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/AgentStep"
          },
          {
            "$ref": "#/$defs/TenantStep"
          },
          {
            "$ref": "#/$defs/HumanStep"
          },
          {
            "$ref": "#/$defs/VisitorStep"
          }
        ]
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "story": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Story",
      "type": "string"
    },
    "title": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "what_to_notice": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "What To Notice",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "group",
    "story",
    "setup",
    "steps",
    "expected",
    "what_to_notice"
  ],
  "title": "Scenario",
  "type": "object"
}
